# Copier ce fichier en .env (jamais commité, voir .gitignore) pour tester
# scripts/grist_to_json.py en local.

# Profil Grist -> API key (https://grist.numerique.gouv.fr)
GRIST_API_KEY=

# Identifiant du document, visible dans l'URL Grist :
# https://grist.numerique.gouv.fr/o/docs/<GRIST_DOC_ID>/Fiches-produits/p/1
GRIST_DOC_ID=toCYiKQga5KP

# Nom de la table
GRIST_TABLE=Produits

# Racine de l'instance Grist (à changer si vous utilisez une autre instance)
GRIST_BASE_URL=https://grist.numerique.gouv.fr
