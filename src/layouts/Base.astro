---
import "@fontsource/fira-sans/500.css";
import "@fontsource/fira-sans/700.css";
import "@fontsource/fira-sans/800.css";
import "@fontsource/open-sans/400.css";
import "@fontsource/open-sans/600.css";
import "@fontsource/open-sans/700.css";
import "../styles/global.css";
import { LIENS } from "../lib/liens";

interface Props {
  title: string;
  description?: string;
}
const { title, description = "L'offre de l'IGN et les ressources du mode produit, pour les agents de l'institut." } = Astro.props;

const base = import.meta.env.BASE_URL;
const path = Astro.url.pathname;
const modeProduitHref = `${base}mode-produit/`;

interface Tab {
  label: string;
  href: string;
  active?: boolean;
  external?: boolean;
}

const sections: { label: string; href: string; active: boolean; tabs: Tab[] }[] = [
  {
    label: "L'offre IGN",
    href: base,
    active: !path.startsWith(modeProduitHref),
    tabs: [
      { label: "Produits", href: base, active: path === base || path.startsWith(`${base}produits/`) },
      { label: "Offre", href: `${base}offre/`, active: path.startsWith(`${base}offre/`) },
    ],
  },
  {
    label: "Le mode produit",
    href: modeProduitHref,
    active: path.startsWith(modeProduitHref),
    tabs: [
      { label: "Présentation", href: modeProduitHref, active: path === modeProduitHref },
      { label: "Agenda", href: `${modeProduitHref}agenda/`, active: path.startsWith(`${modeProduitHref}agenda/`) },
      { label: "Être accompagné", href: `${modeProduitHref}accompagnement/`, active: path.startsWith(`${modeProduitHref}accompagnement/`) },
      { label: "Documentation", href: LIENS.documentation, external: true },
      { label: "Communauté Teams", href: LIENS.teams, external: true },
    ],
  },
];
const current = sections.find((s) => s.active);
---
<!doctype html>
<html lang="fr">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta name="description" content={description} />
  <title>{title} · Equipes Produits IGN</title>
  <link rel="icon" href={`${base}favicon.ico`} type="image/x-icon" />
</head>
<body>
  <a class="skip-link" href="#content">Aller au contenu</a>
  <header class="site-header">
    <div class="site-header__main">
      <div class="container site-header__top">
        <a class="brand" href={base}>
          <span class="brand__mark" aria-hidden="true"></span>
          <span>
            <span class="brand__title">Equipes Produits IGN</span>
            <span class="brand__tagline">L'offre de l'IGN et le mode produit</span>
          </span>
        </a>
      </div>
      <nav class="main-nav" aria-label="Rubriques">
        <div class="container">
          <ul>
            {sections.map((s) => (
              <li><a href={s.href} aria-current={s.active ? "true" : undefined}>{s.label}</a></li>
            ))}
          </ul>
        </div>
      </nav>
    </div>
    {current && (
      <nav class="subnav" aria-label={current.label}>
        <div class="container">
          <ul>
            {current.tabs.map((t) => (
              <li>
                <a
                  href={t.href}
                  aria-current={t.active ? "page" : undefined}
                  target={t.external ? "_blank" : undefined}
                  rel={t.external ? "noopener noreferrer" : undefined}
                >{t.label}</a>
              </li>
            ))}
          </ul>
        </div>
      </nav>
    )}
  </header>
  <main id="content">
    <slot />
  </main>
  <footer class="site-footer">
    <div class="container">
      <div class="site-footer__body">
        <p class="site-footer__brand">Equipes Produits IGN</p>
        <p class="site-footer__desc">
          Ce site présente l'offre de l'IGN, conçue et opérée par ses équipes, et rassemble les ressources du mode produit, à destination des agents de l'institut.
        </p>
      </div>
      <div class="site-footer__bottom">
        <a href="https://www.ign.fr">ign.fr</a>
        <p>Données issues de la base produits IGN — prototype de démonstration.</p>
      </div>
    </div>
  </footer>
</body>
</html>
