---
import "@fontsource/fira-sans/500.css";
import "@fontsource/fira-sans/700.css";
import "@fontsource/fira-sans/800.css";
import "@fontsource/open-sans/400.css";
import "@fontsource/open-sans/600.css";
import "@fontsource/open-sans/700.css";
import "../styles/global.css";

interface Props {
  title: string;
  description?: string;
}
const { title, description = "Catalogue interne des produits numériques portés par les équipes de l'IGN" } = Astro.props;

const homeHref = import.meta.env.BASE_URL;
const offreHref = `${import.meta.env.BASE_URL}offre/`;
const supportHref = `${import.meta.env.BASE_URL}demander-un-accompagnement/`;
const currentPath = Astro.url.pathname;
function isActive(href: string) {
  return currentPath === href || (href !== homeHref && currentPath.startsWith(href));
}
---
<!doctype html>
<html lang="fr">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta name="description" content={description} />
  <title>{title} · Equipes Produits IGN</title>
  <link rel="icon" href={`${import.meta.env.BASE_URL}favicon.svg`} type="image/svg+xml" />
</head>
<body>
  <a class="skip-link" href="#content">Aller au contenu</a>
  <header class="site-header" id="site-header">
    <div class="container site-header__top">
      <a class="brand" href={homeHref}>
        <span class="brand__mark" aria-hidden="true"></span>
        <span>
          <span class="brand__title">Equipes Produits IGN</span>
          <span class="brand__tagline">Catalogue des produits numériques portés par les équipes de l'IGN</span>
        </span>
      </a>
      <button class="menu-toggle" id="menu-toggle" type="button" aria-expanded="false" aria-controls="site-nav-band">Menu</button>
    </div>
    <div class="site-nav-band" id="site-nav-band">
      <div class="container site-nav-band__inner">
        <nav class="main-nav" aria-label="Menu principal">
          <ul>
            <li><a href={homeHref} aria-current={isActive(homeHref) ? "page" : undefined}>Produits</a></li>
            <li><a href={offreHref} aria-current={isActive(offreHref) ? "page" : undefined}>Offre</a></li>
            <li><a href={supportHref} aria-current={isActive(supportHref) ? "page" : undefined}>Demander un accompagnement</a></li>
            <li><a href="https://docs.numerique.gouv.fr/docs/5c50f061-15ea-4ca4-91a2-67147a9d9ca1/" target="_blank" rel="noopener noreferrer">Documentation</a></li>
          </ul>
        </nav>
        <ul class="header-tools">
          <li>
            <a
              class="btn btn--secondary btn--sm"
              href="https://grist.numerique.gouv.fr/o/docs/toCYiKQga5KP/Fiches-produits?utm_id=share-doc"
              target="_blank"
              rel="noopener noreferrer"
            >
              Ajouter un produit
            </a>
          </li>
          <li>
            <a
              class="btn btn--sm btn-teams"
              href="https://teams.microsoft.com/l/team/19%3A6JvfCSpE-uEzmEJ4ZpjR_rPWxN9nTgBLQQOnioZxbDA1%40thread.tacv2/conversations?groupId=54062afb-42c0-4a2e-aae5-17b05157968e&tenantId=3876b373-7e2c-4857-b024-53326b5b4bb2"
              target="_blank"
              rel="noopener noreferrer"
            >
              Rejoindre l'équipe Teams Mode Produit
            </a>
          </li>
        </ul>
      </div>
    </div>
  </header>
  <main id="content">
    <slot />
  </main>
  <footer class="site-footer">
    <div class="container">
      <div class="site-footer__body">
        <p class="site-footer__brand">Equipes Produits IGN</p>
        <p class="site-footer__desc">
          Ce catalogue valorise les produits numériques conçus et opérés par les équipes de l'IGN, à destination des agents de l'institut.
        </p>
      </div>
      <div class="site-footer__bottom">
        <a href="https://www.ign.fr">ign.fr</a>
        <p>Données issues de la base produits IGN — prototype de démonstration.</p>
      </div>
    </div>
  </footer>
  <script>
    const header = document.getElementById("site-header");
    const toggle = document.getElementById("menu-toggle");
    toggle?.addEventListener("click", () => {
      const open = toggle.getAttribute("aria-expanded") === "true";
      toggle.setAttribute("aria-expanded", String(!open));
      header?.classList.toggle("is-open", !open);
    });
  </script>
</body>
</html>
