---
import Base from "../layouts/Base.astro";
import { renderMarkdown } from "../lib/markdown";
import offreMd from "../data/offre.md?raw";

const bodyHtml = renderMarkdown(offreMd.replaceAll("{{BASE}}", import.meta.env.BASE_URL));
---
<Base title="Offre" description="Les six grandes familles de produits et services numériques de l'IGN, et les orientations stratégiques qui les structurent.">
  <section class="hero">
    <div class="container">
      <p class="kicker">Positionnement</p>
      <h1>L'Offre IGN</h1>
      <p class="lead">
        Comment l'institut organise ses produits et services numériques autour de six grandes familles, au service des politiques publiques et des acteurs territoriaux.
      </p>
    </div>
  </section>

  <section class="container section">
    <div class="prose" set:html={bodyHtml} />
  </section>
</Base>
