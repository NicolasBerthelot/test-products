---
import Base from "../../layouts/Base.astro";
import produits from "../../data/produits.json";
import { renderMarkdown } from "../../lib/markdown";

export function getStaticPaths() {
  return produits.map((p) => ({
    params: { slug: p.slug },
    props: { produit: p },
  }));
}

const { produit: p } = Astro.props;

const resources = [
  { label: "Site web", value: p.siteWeb, external: true },
  { label: "Code source", value: p.codeSource, external: true },
  { label: "Statistiques d'usage", value: p.statistiquesUsage, external: true },
  { label: "RACI", value: p.raci, external: true },
  { label: "Budget", value: p.budget, external: true },
].filter((r) => r.value);

const contentSections = [
  { key: "propositionValeur", label: "Proposition de valeur", value: p.propositionValeur },
  { key: "problemes", label: "Problèmes adressés", value: p.problemes },
  { key: "solutions", label: "Solutions apportées", value: p.solutions },
  { key: "canauxDeploiement", label: "Canaux de déploiement", value: p.canauxDeploiement },
  { key: "impactIndicateurs", label: "Impact et indicateurs", value: p.impactIndicateurs },
  { key: "positionnementEcosysteme", label: "Positionnement dans l'écosystème", value: p.positionnementEcosysteme },
  { key: "vision5ans", label: "Vision à 5 ans", value: p.vision5ans },
  { key: "ciblesPrioritaires", label: "Cibles prioritaires", value: p.ciblesPrioritaires },
  { key: "objectifs1an", label: "Principaux objectifs (1 an)", value: p.objectifs1an },
].filter((s) => s.value);

function isUrl(v: string) {
  return /^https?:\/\//i.test(v.trim());
}

const defaultAvatar = `${import.meta.env.BASE_URL}agent.png`;

// Couleur de tag déterministe par direction (préfixe avant "/", ex. "DP"
// dans "DP/SPP" ; "Prestataire" n'a pas de "/" et forme sa propre direction).
// Hash simple -> palette fixe : toute nouvelle direction obtient une couleur
// automatiquement, toujours la même, sans avoir à coder chaque code en dur.
const TAG_PALETTE = ["#0063CB", "#6E445A", "#00694E", "#8D533E", "#417DC4", "#A558A0", "#6A6156", "#C36F31"];

// "Prestataire" hashait sur la même couleur que "DSI" (collision de hash) ;
// couleur dédiée hors palette pour la distinguer sans risquer une nouvelle collision.
const TAG_COLOR_OVERRIDES: Record<string, string> = {
  Prestataire: "#B3261E",
};

function serviceColor(service: string) {
  const direction = service.split("/")[0].trim();
  if (TAG_COLOR_OVERRIDES[direction]) return TAG_COLOR_OVERRIDES[direction];
  let hash = 0;
  for (const char of direction) hash = (hash * 31 + char.charCodeAt(0)) >>> 0;
  return TAG_PALETTE[hash % TAG_PALETTE.length];
}
---
<Base title={p.nom} description={p.promesse || p.propositionValeur}>
  <div class="fr-container fr-mt-3w">
    <nav role="navigation" class="fr-breadcrumb" aria-label="vous êtes ici :">
      <button class="fr-breadcrumb__button" aria-expanded="false" aria-controls="breadcrumb">Voir le fil d'Ariane</button>
      <div class="fr-collapse" id="breadcrumb">
        <ol class="fr-breadcrumb__list">
          <li><a class="fr-breadcrumb__link" href={import.meta.env.BASE_URL}>Accueil</a></li>
          <li><a class="fr-breadcrumb__link" aria-current="page">{p.nom}</a></li>
        </ol>
      </div>
    </nav>
  </div>

  <section class="ign-hero">
    <div class="fr-container">
      {p.offre && <p class="fr-badge fr-badge--yellow-tournesol fr-mb-2w">{p.offre}</p>}
      <h1 class="fr-mb-2w">{p.nom}</h1>
      {p.promesse && <p class="fr-text--lead" style="max-width: 46rem;">{p.promesse}</p>}
    </div>
  </section>

  {p.image && (
    <div class="fr-container fr-mt-1w">
      <img
        class="fr-responsive-img ign-product-image"
        src={p.image.startsWith("http") ? p.image : `${import.meta.env.BASE_URL}${p.image}`}
        alt={`Illustration : ${p.nom}`}
      />
    </div>
  )}

  <div class="fr-container fr-py-6w">
    <div class="fr-grid-row fr-grid-row--gutters">
      {contentSections.length > 0 && (
        <div class="fr-col-12 fr-col-md-3">
          <nav class="fr-summary ign-toc" role="navigation" aria-labelledby="fr-summary-title">
            <p class="fr-summary__title" id="fr-summary-title">Sommaire</p>
            <ol class="fr-summary__list">
              {contentSections.map((s) => (
                <li>
                  <a class="fr-summary__link" href={`#${s.key}`}>{s.label}</a>
                </li>
              ))}
            </ol>
          </nav>
        </div>
      )}

      <div class={contentSections.length > 0 ? "fr-col-12 fr-col-md-6" : "fr-col-12 fr-col-md-8"}>
        {contentSections.map((s) => (
          <section class="fr-mb-4w" id={s.key}>
            <h2 class="fr-h4">{s.label}</h2>
            <div class="ign-markdown" set:html={renderMarkdown(s.value)} />
          </section>
        ))}
        {contentSections.length === 0 && (
          <p class="fr-text--sm" style="color: var(--text-mention-grey, #666);">
            Cette fiche produit n'a pas encore été complétée par l'équipe.
          </p>
        )}
      </div>

      <div class="fr-col-12 fr-col-md-3">
        <div class="fr-card fr-card--no-arrow fr-card--grey fr-mb-3w">
          <div class="fr-card__body">
            <div class="fr-card__content">
              <h2 class="fr-h6 fr-mb-2w">Liens et ressources</h2>
              {resources.length > 0 ? (
                <ul class="fr-btns-group fr-btns-group--icon-left fr-btns-group--sm">
                  {resources.map((r) => (
                    <li>
                      {isUrl(r.value) ? (
                        <a class="fr-btn fr-btn--secondary fr-btn--icon-left fr-icon-external-link-line fr-btn--sm" style="width: 100%; justify-content: flex-start;" href={r.value} target="_blank" rel="noopener noreferrer">
                          {r.label}
                        </a>
                      ) : (
                        <p class="fr-text--sm fr-mb-1w"><strong>{r.label} :</strong> {r.value}</p>
                      )}
                    </li>
                  ))}
                </ul>
              ) : (
                <p class="fr-text--sm">Aucune ressource renseignée.</p>
              )}

              {p.contact && (
                <>
                  <h2 class="fr-h6 fr-mt-4w fr-mb-1w">Contact</h2>
                  <p class="fr-text--sm">{p.contact}</p>
                </>
              )}

              {p.derniereMiseAJour && (
                <p class="ign-updated fr-mt-4w">
                  Dernière mise à jour le {p.derniereMiseAJour.trim()}
                  {p.derniereMiseAJourPar && ` par ${p.derniereMiseAJourPar}`}
                </p>
              )}
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>

  {p.equipe && p.equipe.length > 0 && (
    <section class="ign-team-section">
      <div class="fr-container fr-py-6w">
        <h2 class="fr-h4 fr-mb-3w">Équipe</h2>
        <div class="fr-grid-row fr-grid-row--gutters">
          {p.equipe.map((membre) => (
            <div class="fr-col-6 fr-col-sm-4 fr-col-md-3 fr-col-lg-2">
              <div class="ign-team-card">
                <img
                  class="ign-avatar-lg"
                  src={membre.photo ? (membre.photo.startsWith("http") ? membre.photo : `${import.meta.env.BASE_URL}${membre.photo}`) : defaultAvatar}
                  alt=""
                />
                <p class="ign-team-name">{membre.nom}</p>
                {membre.mail && (
                  <p class="ign-team-actions">
                    <a
                      class="ign-team-icon ign-team-mail"
                      href={`mailto:${membre.mail}`}
                      title={`Envoyer un mail à ${membre.nom}`}
                      aria-label={`Envoyer un mail à ${membre.nom}`}
                    ></a>
                    <a
                      class="ign-team-icon ign-team-teams"
                      href={`https://teams.microsoft.com/l/chat/0/0?users=${encodeURIComponent(membre.mail)}`}
                      target="_blank"
                      rel="noopener noreferrer"
                      title={`Discuter avec ${membre.nom} sur Teams`}
                      aria-label={`Discuter avec ${membre.nom} sur Teams`}
                    ></a>
                  </p>
                )}
                {membre.fonction && <p class="ign-team-role">{membre.fonction}</p>}
                {membre.service && (
                  <span class="ign-service-tag" style={`background-color: ${serviceColor(membre.service)};`}>
                    {membre.service}
                  </span>
                )}
              </div>
            </div>
          ))}
        </div>
      </div>
    </section>
  )}

  <div class="fr-container">
    <div class="fr-mb-4w">
      <a class="fr-link fr-icon-arrow-left-line fr-link--icon-left" href={import.meta.env.BASE_URL}>Retour au catalogue</a>
    </div>
  </div>
</Base>
