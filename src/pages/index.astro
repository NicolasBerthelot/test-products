---
import Base from "../layouts/Base.astro";
import produits from "../data/produits.json";
import { LIENS } from "../lib/liens";

// Ordre de première apparition (= ordre des lignes dans la table Produits sur
// Grist, où les produits sont groupés par offre), pas un tri alphabétique.
const offres = [...new Set(produits.map((p) => p.offre).filter(Boolean))];
const nbAccompagnes = produits.filter((p) => p.accompagneModeProduit).length;

const DIACRITICS = /[̀-ͯ]/g;

function normalize(s: string) {
  return s.normalize("NFD").replace(DIACRITICS, "").toLowerCase();
}

function searchIndex(p: (typeof produits)[number]) {
  const noms = (p.equipe ?? []).map((membre) => membre.nom);
  return normalize([p.nom, p.promesse, ...noms].filter(Boolean).join(" "));
}
---
<Base title="Accueil" description="Les produits numériques portés par les équipes de l'IGN : référentiels, observation du territoire et services associés.">
  <section class="hero">
    <div class="container">
      <p class="kicker">L'offre IGN</p>
      <h1>Les produits numériques portés par les équipes produit de l'IGN</h1>
      <p class="lead">
        Référentiels géographiques, observation du territoire, données ouvertes : découvrez {produits.length} produits que conçoivent et opèrent les équipes de l'IGN — pour savoir qui fait quoi, et qui contacter.
      </p>
      <p class="hero__note">
        Votre produit n'apparaît pas ?{" "}
        <a href={LIENS.referencerProduit} target="_blank" rel="noopener noreferrer">Référencez-le dans le catalogue</a>.
      </p>
    </div>
  </section>

  <div class="filters">
    <div class="container">
      <button
        type="button"
        class="filters-toggle"
        id="filters-toggle"
        aria-expanded="false"
        aria-controls="filters-panel"
      >
        <span>Filtrer les produits</span>
        <span class="filters-toggle__value" id="filters-toggle-value">Toutes les offres</span>
      </button>

      <div class="filters__panel" id="filters-panel">
        <div class="search" role="search">
          <label class="filters__label" for="product-search">Rechercher un produit</label>
          <div class="search__field">
            <input
              placeholder="Nom, promesse, équipe..."
              type="search"
              id="product-search"
              name="product-search"
            />
          </div>
        </div>

        <div class="filter-group">
          <p class="filters__label">Filtrer par offre</p>
          <ul class="chips" id="offre-filters">
            <li>
              <button class="chip" type="button" data-offre="all" aria-pressed="true">
                Toutes les offres ({produits.length})
              </button>
            </li>
            {offres.map((offre) => {
              const count = produits.filter((p) => p.offre === offre).length;
              return (
                <li>
                  <button class="chip" type="button" data-offre={offre} aria-pressed="false">
                    {offre} ({count})
                  </button>
                </li>
              );
            })}
          </ul>
          {nbAccompagnes > 0 && (
            <label class="filter-check">
              <input type="checkbox" id="accompagne-filter" />
              Uniquement les produits accompagnés par le collectif Mode Produit ({nbAccompagnes})
            </label>
          )}
        </div>
      </div>
    </div>
  </div>

  <section class="container section">
    <div class="card-grid" id="product-grid">
      {produits.map((p) => (
        <div
          class="product-item"
          data-offre={p.offre}
          data-search={searchIndex(p)}
          data-accompagne={p.accompagneModeProduit ? "1" : undefined}
        >
          <article class="card">
            {p.image && (
              <img
                class="card__img"
                src={p.image.startsWith("http") ? p.image : `${import.meta.env.BASE_URL}${p.image}`}
                alt=""
              />
            )}
            <div class="card__body">
              {p.accompagneModeProduit && (
                <p class="badge-mp card__badge" title="Accompagné par le collectif Mode Produit">Accompagné Mode Produit</p>
              )}
              {p.offre && <p class="card__offre">{p.offre}</p>}
              <h2 class="card__title">
                <a href={`${import.meta.env.BASE_URL}produits/${p.slug}/`}>{p.nom}</a>
              </h2>
              <p class="card__desc">{p.promesse || p.propositionValeur || "Description à venir."}</p>
              {p.derniereMiseAJour && (
                <p class="card__meta">Fiche mise à jour le {p.derniereMiseAJour.trim()}</p>
              )}
            </div>
          </article>
        </div>
      ))}
    </div>
    <p id="empty-state" hidden aria-live="polite">Aucun produit ne correspond à ces critères.</p>
  </section>

  <script>
    const DIACRITICS = /[̀-ͯ]/g;
    function normalize(s: string) {
      return s.normalize("NFD").replace(DIACRITICS, "").toLowerCase();
    }

    const buttons = document.querySelectorAll<HTMLButtonElement>("#offre-filters .chip");
    const items = document.querySelectorAll<HTMLElement>(".product-item");
    const emptyState = document.getElementById("empty-state");
    const searchInput = document.querySelector<HTMLInputElement>("#product-search");
    const filtersToggle = document.getElementById("filters-toggle");
    const filtersPanel = document.getElementById("filters-panel");
    const filtersToggleValue = document.getElementById("filters-toggle-value");
    const accompagneFilter = document.querySelector<HTMLInputElement>("#accompagne-filter");

    let activeOffre = "all";

    function applyFilters() {
      const term = normalize(searchInput?.value.trim() ?? "");
      const onlyAccompagnes = accompagneFilter?.checked ?? false;
      let visibleCount = 0;
      items.forEach((item) => {
        const matchOffre = activeOffre === "all" || item.dataset.offre === activeOffre;
        const matchSearch = term === "" || (item.dataset.search ?? "").includes(term);
        const matchAccompagne = !onlyAccompagnes || item.dataset.accompagne === "1";
        const match = matchOffre && matchSearch && matchAccompagne;
        item.style.display = match ? "" : "none";
        if (match) visibleCount++;
      });
      if (emptyState) emptyState.hidden = visibleCount > 0;
    }

    buttons.forEach((btn) => {
      btn.addEventListener("click", () => {
        buttons.forEach((b) => b.setAttribute("aria-pressed", "false"));
        btn.setAttribute("aria-pressed", "true");
        activeOffre = btn.dataset.offre ?? "all";
        if (filtersToggleValue) filtersToggleValue.textContent = btn.textContent?.trim() ?? "";
        applyFilters();
      });
    });

    searchInput?.addEventListener("input", applyFilters);
    accompagneFilter?.addEventListener("change", applyFilters);

    filtersToggle?.addEventListener("click", () => {
      const expanded = filtersToggle.getAttribute("aria-expanded") === "true";
      filtersToggle.setAttribute("aria-expanded", String(!expanded));
      filtersPanel?.classList.toggle("is-open", !expanded);
    });
  </script>
</Base>
